"ag" = (/obj/structure/bookcase,/obj/item/book{name = "The Transcendental Eve of Allspace"; desc = "A lesser known book out of the depths of 23rd century Earth that deals with the up and coming demise of the Human race, and how penitence and regrets are a core element of ensuring smooth passage through the hostilities of life. Written by Avril Karlanker, an infamous philosopher during the Terran Commonwealth era."},/obj/item/book{name = "Core Heuristics to Self-Control and Stress-Relief"; desc = "A relic from the 23rd century - a handy guidebook originally written by Skrell wordsmith Xiilqula Quum'qish on human tendencies, behaviours, and mental side-effects. Translated with the help of Cultural Exchange linguists and published in limited amounts after green-light by planetary governments across the Solar Assembly."},/obj/item/book{name = "Destiny Blight"; desc = "A modest best-seller hailing from the lands of Pirx. A romantical tale following the best Rangers from Yuoda City getting into trouble, solving crimes, exploring the lush landscape of Pirx (and eachother). Often claimed to be too gratuitous in its fan service by high-art critics; but enjoyd by the common folk outside of Pirx nonetheless."},/obj/item/book{name = "As Above, So Below"; desc = "An autobiographical tale of a Confederate Pioneer, Leytenant Timur Shoshkevic, and their accounts in the dense, concrete-jungle landscape of Magnitka. Wonder, mechanically monotonous dread, and the bright star so visible from the planet. Leytenant Shoshkevic' book deals with the political, economic and cultural climate of Magnitka, describing it to be 'deliriously autonomous', when compared to their home-colony of Sestris."},/turf/simulated/floor/tiled/dark/monotile,/area/northstar/decktwo)
