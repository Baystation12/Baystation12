{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "auxtools",
      "request": "launch",
      "name": "Build & DS Debug (Auxtools & Hot-Reload)",
      "preLaunchTask": "dm: build - ${command:dreammaker.getFilenameDme}",
      "dmb": "${workspaceFolder}/${command:dreammaker.getFilenameDmb}",
      "server": "dreamseeker"
    },
    {
      "type": "byond",
      "request": "launch",
      "name": "Build & DS Debug",
      "preLaunchTask": "dm: build - ${command:CurrentDME}",
      "dmb": "${workspaceFolder}/${command:CurrentDMB}"
    },
    {
      "type": "byond",
      "request": "launch",
      "name": "DS Debug",
      "dmb": "${workspaceFolder}/${command:CurrentDMB}"
    }
  ]
}
